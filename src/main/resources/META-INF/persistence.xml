<persistence xmlns="http://java.sun.com/xml/ns/persistence"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="http://java.sun.com/xml/ns/persistence http://java.sun.com/xml/ns/persistence/persistence_2_0.xsd"
             version="2.0">
    <persistence-unit name="tm_project2" transaction-type="RESOURCE_LOCAL">
        <properties>
            <property name="javax.persistence.jdbc.url" value="jdbc:mysql://localhost:3306/time_management"/>
            <property name="javax.persistence.jdbc.user" value="root"/>
            <property name="javax.persistence.jdbc.password" value="1825xy"/>
<!--create — создаёт схему базы данных с нуля при каждом запуске приложения. Все существующие таблицы и данные будут удалены.-->
<!--update — обновляет существующую схему базы данных, добавляя новые таблицы и колонки, но не удаляет устаревшие элементы.-->
<!--validate — только проверяет соответствие схемы базы данных и модели данных, не внося изменений. Если есть несоответствия, приложение не запустится.-->
<!--create-drop — создаёт схему при запуске и удаляет её при завершении работы приложения. Удобно для тестов.-->
<!--none — отключает автоматическое управление схемой. Hibernate не будет создавать, обновлять или проверять схему.-->
            <property name="hibernate.ddl-auto" value="update"/>
            <!-- Если вы полностью переходите на hibernate.ddl-auto, можно убрать -->
            <!-- <property name="javax.persistence.schema-generation.database.action" value="drop-and-create"/> -->

<!--            <property name="hibernate.connection.release_mode" value="after_transaction"/>-->
<!--            <property name="hibernate.connection.shutdown" value="true"/>-->
<!--            <property name="hibernate.c3p0.idle_test_period" value="300"/> &lt;!&ndash; 5 минут &ndash;&gt;-->
<!--            <property name="hibernate.c3p0.timeout" value="300"/>     &lt;!&ndash; 5 минут &ndash;&gt;-->

<!--            &lt;!&ndash; Дополнительные настройки пула соединений &ndash;&gt;-->
<!--            <property name="hibernate.c3p0.min_size" value="5"/>-->
<!--            <property name="hibernate.c3p0.max_size" value="20"/>-->
<!--            <property name="hibernate.c3p0.acquire_increment" value="1"/>-->
<!--            <property name="hibernate.c3p0.validate" value="true"/>-->
        </properties>
    </persistence-unit>
</persistence>