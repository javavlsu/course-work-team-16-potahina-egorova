<persistence xmlns="http://java.sun.com/xml/ns/persistence"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="http://java.sun.com/xml/ns/persistence http://java.sun.com/xml/ns/persistence/persistence_2_0.xsd"
             version="2.0">
    <persistence-unit name="tm_project2" transaction-type="RESOURCE_LOCAL">
        <properties>
            <property name="javax.persistence.jdbc.url" value="jdbc:mysql://localhost:3306/time_management"/>
            <property name="javax.persistence.jdbc.user" value="root"/>
            <property name="javax.persistence.jdbc.password" value="1825xy"/>
            <!-- Замените или добавьте это свойство -->
            <property name="hibernate.ddl-auto" value="update"/>
            <!-- Если вы полностью переходите на hibernate.ddl-auto, можно убрать -->
            <!-- <property name="javax.persistence.schema-generation.database.action" value="drop-and-create"/> -->
        </properties>
    </persistence-unit>
</persistence>